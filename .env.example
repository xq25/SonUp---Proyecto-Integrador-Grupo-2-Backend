# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.
#
# Supabase → botón "Connect" del proyecto:
#   DATABASE_URL = Transaction pooler (puerto 6543): runtime de la app.
#   DIRECT_URL   = Session pooler (puerto 5432): CLI de Prisma (db pull).
# Se usan los poolers porque la conexión "Direct" de Supabase solo funciona por IPv6.
# Cambiar de la BD de pruebas del módulo a la BD general = cambiar estas dos URLs.
# Si la contraseña tiene símbolos (@ # / : ? &), codifícalos en la URL (p. ej. @ → %40).

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Opcional: UUID de un usuario de Supabase Auth (= perfil) que `npm run db:check`
# verifica que exista (el `actor` de las pruebas). db:check nunca escribe en la BD.
# DB_CHECK_ACTOR=""

# ── API HTTP (ADR-002) ──
# PORT=3000
# NODE_ENV=production   # OBLIGATORIO al desplegar: desactiva las cabeceras X-Actor-Id/X-Actor-Roles
# ── Seguridad de las rutas (ADR-008) ──
# Secreto HS256 del servicio de seguridad: con él se verifica el JWT localmente.
# Sin él, cada token se verifica con su endpoint de perfil (RENDER_PROFILE_PATH).
# AUTH_JWT_SECRET=""
# AUTH_JWT_ISSUER=""
# AUTH_JWT_AUDIENCE=""
# AUTH_PROFILE_CACHE_SECONDS=60
# Orígenes permitidos (frontend), separados por comas:
# CORS_ORIGIN="http://localhost:5173"

# ── Autenticación del módulo administrativo (ADR-003) ──
# Servicio de login/usuarios/roles del módulo administrativo; nuestras rutas /auth/* lo remiten.
RENDER_API_URL="https://<servicio-administrativo>.onrender.com/"
RENDER_REGISTER_PATH="/auth/registro"
RENDER_LOGIN_PATH="/auth/login"
RENDER_PROFILE_PATH="/auth/perfil"
# Tiempo límite por llamada (ms). Render gratuito tarda ~30 s en despertar: 60000 evita 504 en la primera.
RENDER_HTTP_TIMEOUT_MS=60000

# ── Módulo administrativo: API de Saga (ADR-007) ──
# Sin SAGA_API_URL se leen las tablas simuladas del esquema administrativo (solo desarrollo y pruebas).
# SAGA_API_URL="https://saga-up-backend-lr4u.onrender.com"
# Usuario de servicio de este módulo en el login (lo entrega el equipo de seguridad); su token se envía a Saga.
# SAGA_SERVICE_EMAIL=""
# SAGA_SERVICE_PASSWORD=""
# Solo pruebas: un token ya emitido (dura ~8 h). Se usa mientras Saga lo acepte; nunca lo subas al repositorio.
# SAGA_SERVICE_TOKEN=""
# Tiempo límite por llamada (ms). Render gratuito tarda ~30 s en despertar.
# SAGA_HTTP_TIMEOUT_MS=60000
